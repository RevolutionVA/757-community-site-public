# build output
dist/

# Regenerated from src/data/*.json by prebuild on every build, and embeds a
# "Last generated" date plus the live event list. A committed copy is stale as
# soon as the 6-hourly calendar cron runs, so tracking it only misleads anyone
# reading it on GitHub. Nothing depends on the checked-in file.
public/llms.txt

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# npm lock file (using yarn)
package-lock.json

# backup files
*.backup
*.bak

# Design handoff artifacts (kept locally, not tracked)
design-reference/

# generated social carousel exports
social/exports/

# scraped member photo archive (large, not tracked)
social/event-photos/

# impeccable: per-developer state, not shared
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/sessions/

# cursor hook manifest holds a machine-absolute skill path
.cursor/hooks.json
