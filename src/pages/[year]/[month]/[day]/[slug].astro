---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import { marked } from 'marked';

export async function getStaticPaths() {
  const allEvents = await getCollection('events');

  return allEvents.map(event => {
    const date = new Date(event.data.startDate);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');

    // Extract slug from the entry ID (filename without extension)
    const slug = event.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');

    return {
      params: { year: String(year), month, day, slug },
      props: { event },
    };
  });
}

const { event } = Astro.props;
const { Content } = await event.render();

// Parse dates
const startDate = new Date(event.data.startDate);
const endDate = event.data.endDate ? new Date(event.data.endDate) : null;

// Format dates
const dateOptions: Intl.DateTimeFormatOptions = {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'America/New_York'
};

const timeOptions: Intl.DateTimeFormatOptions = {
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
  timeZone: 'America/New_York'
};

const formattedDate = startDate.toLocaleDateString('en-US', dateOptions);
const formattedStartTime = startDate.toLocaleTimeString('en-US', timeOptions);
const formattedEndTime = endDate ? endDate.toLocaleTimeString('en-US', timeOptions) : null;

// Get related events from the same group
const allEvents = await getCollection('events');
const relatedEvents = allEvents
  .filter(e => e.data.group === event.data.group && e.id !== event.id)
  .filter(e => new Date(e.data.startDate) >= new Date()) // Only future events
  .sort((a, b) => new Date(a.data.startDate).getTime() - new Date(b.data.startDate).getTime())
  .slice(0, 3);

// Try to find the meetup group page
const meetupSlug = event.data.group.toLowerCase()
  .replace(/[^\w\s-]/g, '')
  .replace(/\s+/g, '-')
  .replace(/-+/g, '-')
  .replace(/^-+|-+$/g, '')
  .substring(0, 50);

const isPast = startDate < new Date();

// Construct canonical URL for this event
const canonicalUrl = `/${Astro.params.year}/${Astro.params.month}/${Astro.params.day}/${Astro.params.slug}`;

// Prepare description for meta tags
const metaDescription = event.data.description
  ? event.data.description.substring(0, 160)
  : `${event.data.title} - ${formattedDate}. Join us for this ${event.data.group} event in Hampton Roads!`;

// Prepare JSON-LD structured data for search engines
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": event.data.title,
  "description": event.data.description || `${event.data.title} hosted by ${event.data.group}`,
  "startDate": event.data.startDate,
  "endDate": event.data.endDate || event.data.startDate,
  "eventStatus": event.data.cancelled ? "https://schema.org/EventCancelled" : "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": event.data.location ? {
    "@type": "Place",
    "name": event.data.location,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hampton Roads",
      "addressRegion": "VA",
      "addressCountry": "US"
    }
  } : {
    "@type": "VirtualLocation",
    "url": event.data.sourceUrl
  },
  "image": event.data.image ? `https://757tech.org${event.data.image}` : "https://757tech.org/images/757tech-social-card.jpg",
  "organizer": {
    "@type": "Organization",
    "name": event.data.group,
    "url": `https://757tech.org/meetup/${meetupSlug}`
  },
  "performer": {
    "@type": "Organization",
    "name": event.data.group
  },
  "offers": {
    "@type": "Offer",
    "url": event.data.sourceUrl,
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "validFrom": new Date().toISOString()
  }
};
---

<MainLayout
  title={event.data.title}
  description={metaDescription}
  image={event.data.image || "/images/757tech-social-card.jpg"}
  canonicalUrl={canonicalUrl}
>
  <!-- JSON-LD Structured Data for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="event-page">
    <div class="container">
      <!-- Event Header -->
      <div class="event-header">
        {isPast && (
          <div class="past-event-badge">
            Past Event
          </div>
        )}
        {event.data.featured && (
          <div class="featured-badge">
            Featured Event
          </div>
        )}
        {event.data.cancelled && (
          <div class="cancelled-badge">
            ⚠️ This event has been cancelled
          </div>
        )}

        <h1 class="event-title">{event.data.title}</h1>

        <div class="event-meta">
          <div class="meta-item">
            <span class="meta-icon">📅</span>
            <span class="meta-text">{formattedDate}</span>
          </div>

          <div class="meta-item">
            <span class="meta-icon">⏰</span>
            <span class="meta-text">
              {formattedStartTime}
              {formattedEndTime && ` - ${formattedEndTime}`}
            </span>
          </div>

          {event.data.location && (
            <div class="meta-item">
              <span class="meta-icon">📍</span>
              <span class="meta-text">{event.data.location}</span>
            </div>
          )}

          <div class="meta-item">
            <span class="meta-icon">👥</span>
            <span class="meta-text">
              <a href={`/meetup/${meetupSlug}`} class="group-link">
                {event.data.group}
              </a>
            </span>
          </div>
        </div>

        {event.data.tags && event.data.tags.length > 0 && (
          <div class="event-tags">
            {event.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>

      <!-- RSVP Button -->
      {event.data.sourceUrl && !event.data.cancelled && (
        <div class="rsvp-section">
          <a
            href={event.data.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rsvp-button"
          >
            {isPast ? 'View Event Details' : 'RSVP & Get Details'} →
          </a>
          <p class="rsvp-note">
            {event.data.source === 'meetup' ? 'on Meetup.com' :
             event.data.source === 'conference' ? 'on conference website' :
             'on event website'}
          </p>
        </div>
      )}

      <!-- Event Description -->
      <div class="event-description">
        <h2>About This Event</h2>
        <div class="description-content">
          <Content />
        </div>
      </div>

      <!-- Related Events -->
      {relatedEvents.length > 0 && (
        <div class="related-events">
          <h2>More Events from {event.data.group}</h2>
          <div class="related-events-grid">
            {relatedEvents.map(relatedEvent => {
              const relatedDate = new Date(relatedEvent.data.startDate);
              const year = relatedDate.getFullYear();
              const month = String(relatedDate.getMonth() + 1).padStart(2, '0');
              const day = String(relatedDate.getDate()).padStart(2, '0');
              const slug = relatedEvent.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');
              const eventUrl = `/${year}/${month}/${day}/${slug}`;

              return (
                <a href={eventUrl} class="related-event-card">
                  <div class="related-event-date">
                    <span class="related-day">{relatedDate.getDate()}</span>
                    <span class="related-month">
                      {relatedDate.toLocaleDateString('en-US', { month: 'short' })}
                    </span>
                  </div>
                  <div class="related-event-details">
                    <h3>{relatedEvent.data.title}</h3>
                    <p class="related-event-time">
                      {relatedDate.toLocaleTimeString('en-US', timeOptions)}
                    </p>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Back to Calendar -->
      <div class="back-link">
        <a href="/calendar">← Back to Calendar</a>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .event-page {
    padding: 2rem 0;
    min-height: 60vh;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .event-header {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin-bottom: 2rem;
  }

  .past-event-badge,
  .featured-badge,
  .cancelled-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-weight: 600;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .past-event-badge {
    background-color: #6c757d;
    color: white;
  }

  .featured-badge {
    background-color: #007bff;
    color: white;
  }

  .cancelled-badge {
    background-color: #dc3545;
    color: white;
  }

  .event-title {
    font-size: 2.5rem;
    margin: 0 0 1.5rem 0;
    color: #343a40;
  }

  .event-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
  }

  .meta-icon {
    font-size: 1.25rem;
  }

  .meta-text {
    color: #495057;
  }

  .group-link {
    color: #007bff;
    text-decoration: none;
  }

  .group-link:hover {
    text-decoration: underline;
  }

  .event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tag {
    background-color: #e9ecef;
    color: #495057;
    padding: 0.25rem 0.75rem;
    border-radius: 16px;
    font-size: 0.875rem;
  }

  .rsvp-section {
    text-align: center;
    margin-bottom: 2rem;
  }

  .rsvp-button {
    display: inline-block;
    background-color: #007bff;
    color: white;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .rsvp-button:hover {
    background-color: #0056b3;
    transform: translateY(-2px);
  }

  .rsvp-note {
    margin-top: 0.5rem;
    color: #6c757d;
    font-size: 0.875rem;
  }

  .event-description {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin-bottom: 2rem;
  }

  .event-description h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    color: #343a40;
  }

  .description-content {
    line-height: 1.8;
    color: #495057;
  }

  .description-content :global(p) {
    margin-bottom: 1rem;
  }

  .description-content :global(a) {
    color: #007bff;
    text-decoration: none;
  }

  .description-content :global(a:hover) {
    text-decoration: underline;
  }

  .description-content :global(ul),
  .description-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }

  .description-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .related-events {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin-bottom: 2rem;
  }

  .related-events h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    color: #343a40;
  }

  .related-events-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .related-event-card {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background-color: #f8f9fa;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .related-event-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .related-event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 60px;
    padding: 0.5rem;
    background-color: #007bff;
    color: white;
    border-radius: 4px;
    text-align: center;
  }

  .related-day {
    font-size: 1.5rem;
    font-weight: bold;
    line-height: 1;
  }

  .related-month {
    font-size: 0.875rem;
    text-transform: uppercase;
  }

  .related-event-details h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
    color: #343a40;
  }

  .related-event-time {
    margin: 0;
    font-size: 0.875rem;
    color: #6c757d;
  }

  .back-link {
    text-align: center;
    margin-top: 2rem;
  }

  .back-link a {
    color: #007bff;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .back-link a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .event-title {
      font-size: 1.75rem;
    }

    .rsvp-button {
      font-size: 1.1rem;
      padding: 0.75rem 1.5rem;
    }

    .event-description,
    .related-events,
    .event-header {
      padding: 1.5rem;
    }
  }
</style>
