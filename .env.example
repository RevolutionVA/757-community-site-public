# Bento API credentials — resolved at runtime by 1Password CLI, never store raw values here.
# Copy to .env (gitignored) and run scripts via:
#   op run --account revolutionva.1password.com --env-file .env -- node scripts/create-bento-broadcast.js <email.txt>
#
# Item "Bento - RevolutionVA" lives in the Employee vault of the revolutionva.1password.com account.

BENTO_PUBLISHABLE_KEY=op://Employee/Bento - RevolutionVA/publishable_key
BENTO_SECRET_KEY=op://Employee/Bento - RevolutionVA/secret_key
BENTO_SITE_UUID=op://Employee/Bento - RevolutionVA/site_uuid

# Sender — must be an authorized author in Bento
BENTO_FROM_EMAIL=newsletter@revolutionva.org
BENTO_FROM_NAME=757tech

# Audience segment id — "757Tech Weekly Subscribed" (list segments: GET /v1/fetch/segments)
BENTO_SEGMENT_ID=33230
